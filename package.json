{
  "name": "orchard-store",
  "version": "1.0.0",
  "private": true,
  "description": "Orchard — an Apple devices store built with React and TypeScript",
  "author": "Mykyta Arkatov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arkatovnikita/orchard-store.git"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.1.1",
    "prettier": "^3.3.2",
    "sass": "^1.77.8",
    "stylelint": "^16.7.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-scss": "^6.14.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-svgr": "^4.5.0"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint src --ext .ts,.tsx --fix && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --nojekyll"
  }
}
